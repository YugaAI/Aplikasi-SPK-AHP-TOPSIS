@startuml 02_activity_09_profile
title Activity Diagram - Menu Profil Saya

|Pengguna|
start
:Pilih menu "Profil Saya";

|Sistem|
:Ambil data pengguna\nyang sedang login (currentUser);
:Tampilkan data profil pengguna;

|Pengguna|
:Pilih aksi;

fork
  :Ubah nama lengkap;
  :Klik "Simpan Profil";
  |Sistem|
  if (currentUser tersedia?) then (Tidak)
    :Tampilkan pesan error\n"Tidak ada user yang login";
    |Pengguna|
    stop
  else (Ya)
  endif
  :Perbarui nama lengkap\npengguna di database;
  :Tampilkan notifikasi\n"Profil berhasil diperbarui";

fork again
  :Isi password lama\ndan password baru;
  :Klik "Ubah Password";
  |Sistem|
  if (currentUser tersedia?) then (Tidak)
    :Tampilkan pesan error\n"Tidak ada user yang login";
    |Pengguna|
    stop
  else (Ya)
  endif
  :Verifikasi password lama\n(BCrypt.checkpw);
  if (Password lama\nbenar?) then (Tidak)
    :Tampilkan pesan error\n"Password lama salah";
    |Pengguna|
    :Perbaiki input;
    |Sistem|
  else (Ya)
  endif
  if (Password baru\n< 4 karakter?) then (Ya)
    :Tampilkan pesan error\n"Password baru minimal 4 karakter";
    |Pengguna|
    :Perbaiki input;
    |Sistem|
  else (Tidak)
  endif
  :Hash password baru\n(BCrypt);
  :Perbarui password\ndi database;
  :Tampilkan notifikasi\n"Password berhasil diubah";

end fork

|Pengguna|
:Melihat konfirmasi\nperubahan berhasil;

stop
@enduml
