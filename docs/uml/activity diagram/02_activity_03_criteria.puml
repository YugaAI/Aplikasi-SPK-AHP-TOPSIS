@startuml 02_activity_03_criteria
title Activity Diagram - Menu Manajemen Kriteria

|Admin|
start
:Pilih menu "Kriteria";

|Sistem|
:Ambil daftar kriteria dari database;
:Tampilkan daftar kriteria;

|Admin|
:Pilih aksi;

fork
  :Input data kriteria;
fork again
  :Update data kriteria;
fork again
  :Delete data kriteria;
end fork

|Sistem|
if (Validasi data?) then (Tidak)
  :Tampilkan pesan error validasi;
  |Admin|
  :Perbaiki data;
  |Sistem|
else (Ya)
endif

if (Aksi = Delete?) then (Ya)
  :Ambil data kriteria\ndari database;
  if (Data ditemukan?) then (Ya)
    :Hapus data kriteria dan\npenilaian terkait dari database;
  else (Tidak)
    :Tampilkan pesan error\n"Kriteria tidak ditemukan";
  endif
else (Tidak)
  :Proses insert/update\ndata kriteria ke database;
endif

:Ambil ulang daftar kriteria\ndari database;
:Tampilkan daftar kriteria terbaru;

|Admin|
:Melihat daftar kriteria terbaru;

stop
@enduml
