@startuml 02_activity_08_user_management
title Activity Diagram - Menu Kelola User (Admin)

|Admin|
start
:Pilih menu "Kelola User";

|Sistem|
:Ambil daftar pengguna dari database;
:Tampilkan daftar pengguna;

|Admin|
:Pilih aksi;

fork
  :Input data pengguna baru;
fork again
  :Update data pengguna;
fork again
  :Reset password pengguna;
fork again
  :Delete pengguna;
end fork

|Sistem|
if (Validasi data?) then (Tidak)
  :Tampilkan pesan error validasi\n(username kosong / password < 4 karakter\n/ role tidak valid);
  |Admin|
  :Perbaiki data;
  |Sistem|
else (Ya)
endif

if (Aksi = Tambah\natau Update?) then (Ya)
  :Cek duplikasi username\ndi database;
  if (Username sudah\ndigunakan?) then (Ya)
    :Tampilkan pesan error\n"Username sudah digunakan";
    |Admin|
    :Perbaiki data;
    |Sistem|
  else (Tidak)
  endif
else (Tidak)
endif

if (Aksi = Delete?) then (Ya)
  :Cek apakah user = akun\nyang sedang login;
  if (User = akun sendiri?) then (Ya)
    :Tampilkan pesan error\n"Tidak dapat menghapus\nakun sendiri";
    |Admin|
    :Batalkan;
    |Sistem|
  else (Tidak)
    :Hapus pengguna dari database;
  endif
else (Tidak)
  if (Aksi = Reset Password?) then (Ya)
    :Hash password baru\n(BCrypt);
    :Perbarui password\ndi database;
  else (Tidak)
    :Proses insert/update\ndata pengguna ke database;
  endif
endif

:Ambil ulang daftar pengguna\ndari database;
:Tampilkan daftar pengguna terbaru;

|Admin|
:Melihat daftar pengguna terbaru;

stop
@enduml
