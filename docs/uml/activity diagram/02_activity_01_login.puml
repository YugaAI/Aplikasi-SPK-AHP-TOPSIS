@startuml 02_activity_01_login
title Activity Diagram - Menu Login

|Admin / Pengguna|
start
:Akses halaman login;
:Input username dan password;
:Klik tombol "Masuk";

|Sistem|
if (Input kosong?) then (Ya)
  :Tampilkan pesan error\n"Username/Password tidak boleh kosong";
  |Admin / Pengguna|
  :Perbaiki input;
  |Sistem|
else (Tidak)
endif

:Cari user berdasarkan username\ndi database;

if (User ditemukan?) then (Tidak)
  :Tampilkan pesan error\n"Username atau password salah";
  |Admin / Pengguna|
  :Perbaiki input;
  |Sistem|
else (Ya)
endif

:Verifikasi password\n(BCrypt.checkpw);

if (Password sesuai?) then (Tidak)
  :Tampilkan pesan error\n"Username atau password salah";
  |Admin / Pengguna|
  :Perbaiki input;
  |Sistem|
else (Ya)
endif

:Set sesi pengguna aktif\n(currentUser = user);

if (Role = Admin?) then (Ya)
  :Arahkan ke halaman Dashboard;
else (Tidak)
  :Arahkan ke halaman\nHasil TOPSIS;
endif

|Admin / Pengguna|
:Melihat halaman utama;

stop
@enduml
